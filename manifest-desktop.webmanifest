{
  "id": "./desktop.html",
  "name": "Наша кухня — компьютер",
  "short_name": "Наша кухня ПК",
  "description": "Рецепты, меню недели, покупки и расходы — версия для компьютера",
  "lang": "ru",
  "start_url": "./desktop.html#/recipes",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f3ec",
  "theme_color": "#c2562f",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./desktop.html",
      "accept": {
        "application/pdf": [".pdf"],
        "text/plain": [".txt", ".md"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
      }
    }
  ],
  "shortcuts": [
    { "name": "Меню недели", "url": "./desktop.html#/menu", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Покупки", "url": "./desktop.html#/shopping", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Аналитика", "url": "./desktop.html#/stats", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
